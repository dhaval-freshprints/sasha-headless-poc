# Fresh Prints deployment (all destinations required; no environment defaults)
FP_ENVIRONMENT=
FP_BASE_URL=
FP_LOGIN_URL=
FP_CATALOG_URL=
FP_DESIGNS_URL=
FP_DESIGN_TOOL_URL=
FP_HELP_CENTER_URL=
FP_HQ_BASE_URL=
FP_USER=
FP_PASSWORD=

# OpenAI managed agent
OPENAI_API_KEY=
OPENAI_EXECUTOR_API_KEY=
OPENAI_AGENT_MODEL=gpt-6-sol
OPENAI_AGENT_REASONING_EFFORT=medium

# Cost estimate rates for OPENAI_AGENT_MODEL
OPENAI_AGENT_INPUT_USD_PER_MILLION=2.00
OPENAI_AGENT_CACHED_INPUT_USD_PER_MILLION=0.20
OPENAI_AGENT_OUTPUT_USD_PER_MILLION=10.00

# Local managed runner (FP_ENVIRONMENT is appended to the runs directory)
OPENAI_MANAGED_SANDBOX_IMAGE=sasha-openai-managed:local
OPENAI_MANAGED_RUNS_DIRECTORY=runs/openai-managed
OPENAI_MANAGED_CONNECT_TIMEOUT_SECONDS=90
OPENAI_MANAGED_TURN_TIMEOUT_SECONDS=1200

# Web app (FP_ENVIRONMENT is appended to both directories)
SASHA_WEB_JOBS_DIRECTORY=runs/webapp/jobs
SASHA_WEB_DEALS_DIRECTORY=runs/webapp/deals

# Independent Deal Manager Agent (same OpenAI keys/model; no FP browser login)
DEAL_MANAGER_IMAGE=deal-manager-agent:local
DEAL_MANAGER_DIRECTORY=runs/deal-manager-agent
DEAL_MANAGER_TIMEOUT_SECONDS=600
# Required: actual schema names for each role (no built-in defaults)
DEAL_MANAGER_MAIN_SCHEMA=
DEAL_MANAGER_OPERATIONS_SCHEMA=
NON_PROD_HOST=
NON_PROD_PORT=3306
NON_PROD_USER=
NON_PROD_PASS=
# Actual sender email stored on generated Sasha drafts
SASHA_SENDER_EMAIL=

# Client response without deal ID: "active deal" means managed by this Sasha user
SASHA_USER_ID=297140
# Deal consolidation writes to the CRM through the v3 API, like Sasha v3 (leave blank to never write)
V3_API_BASE_URL=
JWT_AUTH_KEY=
SASHA_ADMIN_USER=
# Inbound email from these domains is internal team mail (comma-separated)
INTERNAL_SENDER_DOMAINS=freshprints.com

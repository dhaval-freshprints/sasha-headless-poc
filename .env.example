# Copy to .env and fill in.

# Fresh Prints staging
FP_BASE_URL=https://v4-qa.internal-fp.com
FP_LOGIN_URL=https://v3-qa.internal-fp.com/dashboard/login
FP_USER=qatest@yopmail.com
FP_PASSWORD=

# Model — any OpenAI-compatible endpoint. List models: GET $LLM_BASE_URL/models
LLM_BASE_URL=http://192.168.29.70:8317/v1
LLM_API_KEY=
MODEL=claude-opus-5

# Loop limits
MAX_STEPS=40
SNAPSHOT_MAX_CHARS=30000
SCREENSHOTS_TO_KEEP=3

# Where runs (step logs + screenshots) are written
RUNS_DIR=runs

# Copy to .env and fill in.

# Fresh Prints staging
FP_BASE_URL=https://v4-qa.internal-fp.com
# DT_BASE_URL=https://dt-qa.internal-fp.com   # the Design Tool; QA default
FP_LOGIN_URL=https://v3-qa.internal-fp.com/dashboard/login
FP_USER=qatest@yopmail.com
FP_PASSWORD=

# Claude via the Anthropic API. The model must support browser_toolset_20260801
# (claude-opus-5, claude-sonnet-5, claude-fable-5-1, claude-opus-4-8).
ANTHROPIC_API_KEY=
MODEL=claude-opus-5

# Work limits (MAX_STEPS remains a legacy alias for MAX_BATCHES)
MAX_BATCHES=40
MAX_ACTIONS=120
MAX_TURN_SECONDS=600
MAX_KEY_REPEAT=20
# Reserve a short verification window when a work limit is reached
MAX_VERIFICATION_ACTIONS=8
VERIFICATION_SECONDS=45
MODEL_TIMEOUT_SECONDS=60
PAGE_TEXT_MAX_CHARS=30000

# Hosts the browser may open. Default: the two FP hosts above plus www.freshprints.com.
# ALLOWED_HOSTS=v4-qa.internal-fp.com,v3-qa.internal-fp.com,www.freshprints.com

# Where runs (step logs + screenshots) are written
RUNS_DIR=runs

# OpenAI-managed outreach POC
OPENAI_API_KEY=
OPENAI_EXECUTOR_API_KEY=
OPENAI_AGENT_MODEL=gpt-6-sol
OPENAI_AGENT_INPUT_USD_PER_MILLION=2.00
OPENAI_AGENT_CACHED_INPUT_USD_PER_MILLION=0.20
OPENAI_AGENT_OUTPUT_USD_PER_MILLION=10.00
OPENAI_AGENT_REASONING_EFFORT=medium
OPENAI_MANAGED_SANDBOX_IMAGE=sasha-openai-managed:local
# OPENAI_MANAGED_RUNS_DIRECTORY=runs/openai-managed
# OPENAI_MANAGED_CONNECT_TIMEOUT_SECONDS=90
# OPENAI_MANAGED_TURN_TIMEOUT_SECONDS=600

# Fresh Prints deployment (all destinations required; no environment defaults)
FP_ENVIRONMENT=
FP_BASE_URL=
FP_LOGIN_URL=
FP_CATALOG_URL=
FP_DESIGNS_URL=
FP_DESIGN_TOOL_URL=
FP_HELP_CENTER_URL=
FP_HQ_BASE_URL=
FP_USER=
FP_PASSWORD=

# Account Manager agent
OPENAI_API_KEY=
OPENAI_EXECUTOR_API_KEY=
OPENAI_AGENT_MODEL=gpt-6-sol
OPENAI_AGENT_REASONING_EFFORT=medium
# Image model Sasha uses to recreate print artwork from a client's photo or screenshot of a shirt
ARTWORK_IMAGE_MODEL=gpt-image-1

# Cost estimate rates for OPENAI_AGENT_MODEL
OPENAI_AGENT_INPUT_USD_PER_MILLION=2.00
OPENAI_AGENT_CACHED_INPUT_USD_PER_MILLION=0.20
OPENAI_AGENT_OUTPUT_USD_PER_MILLION=10.00

# Local managed runner (FP_ENVIRONMENT is appended to the runs directory)
ACCOUNT_MANAGER_AGENT_SANDBOX_IMAGE=sasha-account-manager-agent:local
ACCOUNT_MANAGER_AGENT_RUNS_DIRECTORY=runs/account-manager-agent
ACCOUNT_MANAGER_AGENT_CONNECT_TIMEOUT_SECONDS=90
ACCOUNT_MANAGER_AGENT_TURN_TIMEOUT_SECONDS=1200
# Disposable Chrome container resources for Design Tool / quoter work (defaults: 2 CPUs, 3g RAM, 1g shm)
ACCOUNT_MANAGER_AGENT_CONTAINER_CPUS=2
ACCOUNT_MANAGER_AGENT_CONTAINER_MEMORY=3g
ACCOUNT_MANAGER_AGENT_CONTAINER_SHM_SIZE=1g

# Web app (FP_ENVIRONMENT is appended to both directories)
SASHA_WEB_JOBS_DIRECTORY=runs/webapp/jobs
SASHA_WEB_DEALS_DIRECTORY=runs/webapp/deals

# Independent Deal Manager Agent (same OpenAI keys/model; no FP browser login)
DEAL_MANAGER_IMAGE=deal-manager-agent:local
DEAL_MANAGER_DIRECTORY=runs/deal-manager-agent
DEAL_MANAGER_TIMEOUT_SECONDS=600
# Required: actual schema names for each role (no built-in defaults)
DEAL_MANAGER_MAIN_SCHEMA=
DEAL_MANAGER_OPERATIONS_SCHEMA=
NON_PROD_HOST=
NON_PROD_PORT=3306
NON_PROD_USER=
NON_PROD_PASS=
# Actual sender email stored on generated Sasha drafts
SASHA_SENDER_EMAIL=

# Deal consolidation writes to the CRM through the v3 API, like Sasha v3 (leave blank to never write)
V3_API_BASE_URL=
JWT_AUTH_KEY=
SASHA_ADMIN_USER=
# Inbound email from these domains is internal team mail (comma-separated)
INTERNAL_SENDER_DOMAINS=freshprints.com

# Handoff to a person (ISA). Offers use v3's sasha_handoff_isas / sasha_handoff_offers tables.
# An ISA offer times out after this many working minutes (Mon–Fri 08:00–17:00 New York)
HANDOFF_OFFER_TIMEOUT_MINUTES=20
# How often the web app checks for timed-out offers; 0 turns the check off
HANDOFF_TIMEOUT_CHECK_SECONDS=300

# Free samples: Freshdesk "New Sample Requested" tickets in the Sample Orders group.
# Sample limits come from sasha_settings (followup_sample_max_unit_value, sample_max_per_deal,
# followup_sample_cooldown_days). Without FRESHDESK_DOMAIN and FRESHDESK_API_KEY, samples are
# stored but no ticket is created.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
# Optional: defaults to the Sample Orders group 1069000474780 and SASHA_SENDER_EMAIL
FRESHDESK_SAMPLE_GROUP_ID=
FRESHDESK_REQUESTER_EMAIL=

# Automatic follow-ups: how often the web app looks for deals whose follow-up day has arrived
# (Account Manager chooses the day). Runs only when sasha_settings has sasha_master_key=enabled and
# auto_followup_enabled=true, Mon–Fri 8:00–17:00 New York. 0 turns the check off.
FOLLOWUP_CHECK_SECONDS=3600

# Poll Freshdesk for open sample-order tickets and update sasha_sample_requests (not part of follow-ups). 0 disables.
SAMPLE_FRESHDESK_SYNC_SECONDS=1800

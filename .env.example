# Copy to .env and fill in.

# Fresh Prints staging
FP_BASE_URL=https://v4-qa.internal-fp.com
FP_LOGIN_URL=https://v3-qa.internal-fp.com/dashboard/login
FP_USER=qatest@yopmail.com
FP_PASSWORD=

# Model. LLM_PROVIDER: openai, anthropic, or gateway (OpenAI-compatible proxy; needs LLM_BASE_URL).
# For openai/anthropic direct, leave LLM_BASE_URL empty and put the vendor key in LLM_API_KEY.
LLM_PROVIDER=gateway
LLM_BASE_URL=http://192.168.29.70:8317/v1
LLM_API_KEY=
MODEL=claude-opus-5

# Loop limits
MAX_STEPS=40
SNAPSHOT_MAX_CHARS=30000

# Where runs (step logs + screenshots) are written
RUNS_DIR=runs
